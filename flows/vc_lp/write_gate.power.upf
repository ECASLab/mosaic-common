# Baseline always-on domain for this technology-independent combinational leaf.
set_design_top write_gate
create_power_domain PD_WRITE_GATE -include_scope
create_supply_port VDD -domain PD_WRITE_GATE
create_supply_port VSS -domain PD_WRITE_GATE
create_supply_net VDD -domain PD_WRITE_GATE
create_supply_net VSS -domain PD_WRITE_GATE
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_WRITE_GATE -primary_power_net VDD -primary_ground_net VSS

# Isolation, retention, level shifting, power switching, and their signoff
# belong to the first integrating hierarchy that implements those strategies.
