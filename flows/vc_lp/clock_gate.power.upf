# VC LP is disabled for the technology-independent clock-gate release. This
# baseline places the portable wrapper in one always-powered domain and leaves
# power switching, isolation, retention, and control-domain crossings to the
# integrating design.
set_design_top clock_gate

create_power_domain PD_CLOCK_GATE -include_scope
create_supply_port VDD -domain PD_CLOCK_GATE
create_supply_port VSS -domain PD_CLOCK_GATE
create_supply_net VDD -domain PD_CLOCK_GATE
create_supply_net VSS -domain PD_CLOCK_GATE
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_CLOCK_GATE -primary_power_net VDD -primary_ground_net VSS

# If the gate controls a switchable domain, integration-level UPF must define
# the always-on control source, power states, isolation, retention, and legal
# clock availability during power-up and power-down sequencing.
