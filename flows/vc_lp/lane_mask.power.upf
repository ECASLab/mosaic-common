# This portable combinational leaf is modeled in one always-powered domain.
set_design_top lane_mask

create_power_domain PD_LANE_MASK -include_scope
create_supply_port VDD -domain PD_LANE_MASK
create_supply_port VSS -domain PD_LANE_MASK
create_supply_net VDD -domain PD_LANE_MASK
create_supply_net VSS -domain PD_LANE_MASK
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_LANE_MASK -primary_power_net VDD -primary_ground_net VSS
