# VC LP is a conditional leaf-release skip. This baseline describes an
# always-powered domain and must be extended for switchable or multi-voltage use.
set_design_top reset_synchronizer

create_power_domain PD_RESET_SYNCHRONIZER -include_scope
create_supply_port VDD -domain PD_RESET_SYNCHRONIZER
create_supply_port VSS -domain PD_RESET_SYNCHRONIZER
create_supply_net VDD -domain PD_RESET_SYNCHRONIZER
create_supply_net VSS -domain PD_RESET_SYNCHRONIZER
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_RESET_SYNCHRONIZER -primary_power_net VDD -primary_ground_net VSS

# Switchable-domain integration must define clock availability, isolation of
# o_rstb, and power/isolation/clock/reset wakeup ordering.
