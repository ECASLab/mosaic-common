set_design_top priority_encoder
create_power_domain PD_PRIORITY_ENCODER -include_scope
create_supply_port VDD -domain PD_PRIORITY_ENCODER
create_supply_port VSS -domain PD_PRIORITY_ENCODER
create_supply_net VDD -domain PD_PRIORITY_ENCODER
create_supply_net VSS -domain PD_PRIORITY_ENCODER
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_PRIORITY_ENCODER -primary_power_net VDD -primary_ground_net VSS
