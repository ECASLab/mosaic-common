[options]
mode cover
depth 2

[engines]
smtbmc bitwuzla

[script]
read -formal -D MOSAIC_FORMAL -D MOSAIC_YOSYS_FORMAL -D FORMAL_COVERAGE -sv operand_isolation.sv operand_isolation_coverage.sv operand_isolation_coverage_bind.sv operand_isolation_formal.sv
prep -top operand_isolation_formal

[files]
rtl/operand_isolation.sv
verif/coverage/operand_isolation_coverage.sv
verif/coverage/operand_isolation_coverage_bind.sv
verif/formal/operand_isolation_formal.sv
