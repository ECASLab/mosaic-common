[options]
# Eight steps cover reset, capture, hold, and transition cover goals for all four
# structural parameter combinations instantiated by the formal harness.
mode prove
depth 8

[engines]
# Bitwuzla is provided by the pinned OSS CAD Suite.
smtbmc bitwuzla

[script]
# The harness instantiates the complete reset-style and enable-style matrix.
read -formal -sv dff.sv dff_formal.sv
prep -top dff_formal

[files]
rtl/dff.sv
verif/formal/dff_formal.sv
