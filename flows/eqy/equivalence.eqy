# Compare source RTL with the netlist produced by the required Yosys flow.
[gold]
read_verilog -sv rtl/dff.sv
prep -top dff

[gate]
# Outputs are isolated by module so parallel jobs cannot consume another design.
read_verilog work/dff/yosys_synthesis/dff_netlist.v
prep -top dff

[strategy sby]
# Use an SMT-backed sequential proof so state matching cannot mask an incorrect
# reset, capture, or hold transition.
use sby
depth 8
engine smtbmc bitwuzla
