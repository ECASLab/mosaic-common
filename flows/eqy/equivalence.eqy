# Compare source RTL with the netlist produced by the required Yosys flow.
[gold]
read_verilog -sv rtl/mosaic_dff.sv
prep -top mosaic_dff

[gate]
# Outputs are isolated by module so parallel jobs cannot consume another design.
read_verilog work/dff/yosys_synthesis/mosaic_dff_netlist.v
prep -top mosaic_dff

[strategy sat]
# The DFF state transition is one cycle; depth eight covers reset and several
# capture or hold transitions while remaining inexpensive.
use sat
depth 8
